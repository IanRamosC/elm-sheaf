{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "**",
      "!test/fixtures/**/content",
      "!templates/default/content",
      "!**/.sheaf",
      "!**/dist",
      "!**/elm-stuff"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["templates/default/static/style.css"],
      "linter": { "rules": { "complexity": { "noImportantStyles": "off" } } }
    }
  ],
  "formatter": { "enabled": true, "indentStyle": "space" }
}
