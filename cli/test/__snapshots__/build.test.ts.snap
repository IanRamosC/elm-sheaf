      <guid isPermaLink="true">https://example.com/blog/posts/pictures/</guid>
      <pubDate>Thu, 19 Nov 2026 00:00:00 GMT</pubDate>
      <description>&lt;p&gt;Every image is published in several widths.&lt;/p&gt;&lt;p&gt;&lt;picture&gt;&lt;source type=&quot;image/webp&quot; srcset=&quot;https://example.com/blog/_sheaf/images/6408dc9e106f009b-480.webp 480w, https://example.com/blog/_sheaf/images/6408dc9e106f009b-960.webp 960w, https://example.com/blog/_sheaf/images/6408dc9e106f009b-1200.webp 1200w&quot; sizes=&quot;(min-width: 1200px) 1200px, 100vw&quot;&gt;&lt;img src=&quot;https://example.com/blog/_sheaf/images/6408dc9e106f009b-1200.png&quot; srcset=&quot;https://example.com/blog/_sheaf/images/6408dc9e106f009b-480.png 480w, https://example.com/blog/_sheaf/images/6408dc9e106f009b-960.png 960w, https://example.com/blog/_sheaf/images/6408dc9e106f009b-1200.png 1200w&quot; sizes=&quot;(min-width: 1200px) 1200px, 100vw&quot; width=&quot;1200&quot; height=&quot;800&quot; alt=&quot;A photo&quot; loading=&quot;lazy&quot; decoding=&quot;async&quot;&gt;&lt;/picture&gt;&lt;/p&gt;&lt;aside class=&quot;callout note&quot;&gt;&lt;p&gt;Each post is in the feeds too, as &lt;a href=&quot;https://example.com/blog/posts/feeds/&quot;&gt;the feeds post&lt;/a&gt; explains.&lt;/p&gt;&lt;/aside&gt;&lt;pre class=&quot;shiki&quot; style=&quot;background-color:#ffffff;--shiki-dark-bg:#0d1117;color:#1f2328;--shiki-dark:#e6edf3&quot; tabindex=&quot;0&quot;&gt;&lt;code class=&quot;language-elm&quot;&gt;&lt;span class=&quot;line&quot;&gt;&lt;span style=&quot;color:#8250DF;--shiki-dark:#D2A8FF&quot;&gt;isSmall&lt;/span&gt;&lt;span style=&quot;color:#1F2328;--shiki-dark:#E6EDF3&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color:#CF222E;--shiki-dark:#FF7B72&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;color:#1F2328;--shiki-dark:#E6EDF3&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color:#CF222E;--shiki-dark:#FF7B72&quot;&gt;Int&lt;/span&gt;&lt;span style=&quot;color:#1F2328;--shiki-dark:#E6EDF3&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color:#CF222E;--shiki-dark:#FF7B72&quot;&gt;-&amp;gt;&lt;/span&gt;&lt;span style=&quot;color:#1F2328;--shiki-dark:#E6EDF3&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color:#CF222E;--shiki-dark:#FF7B72&quot;&gt;Bool&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;line&quot;&gt;&lt;span style=&quot;color:#8250DF;--shiki-dark:#D2A8FF&quot;&gt;isSmall&lt;/span&gt;&lt;span style=&quot;color:#1F2328;--shiki-dark:#E6EDF3&quot;&gt; count &lt;/span&gt;&lt;span style=&quot;color:#CF222E;--shiki-dark:#FF7B72&quot;&gt;=&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;line&quot;&gt;&lt;span style=&quot;color:#1F2328;--shiki-dark:#E6EDF3&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color:#0550AE;--shiki-dark:#79C0FF&quot;&gt;0&lt;/span&gt;&lt;span style=&quot;color:#1F2328;--shiki-dark:#E6EDF3&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color:#CF222E;--shiki-dark:#FF7B72&quot;&gt;&amp;lt;&lt;/span&gt;&lt;span style=&quot;color:#1F2328;--shiki-dark:#E6EDF3&quot;&gt; count &lt;/span&gt;&lt;span style=&quot;color:#CF222E;--shiki-dark:#FF7B72&quot;&gt;&amp;amp;&amp;amp;&lt;/span&gt;&lt;span style=&quot;color:#1F2328;--shiki-dark:#E6EDF3&quot;&gt; count &lt;/span&gt;&lt;span style=&quot;color:#CF222E;--shiki-dark:#FF7B72&quot;&gt;&amp;lt;&lt;/span&gt;&lt;span style=&quot;color:#1F2328;--shiki-dark:#E6EDF3&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color:#0550AE;--shiki-dark:#79C0FF&quot;&gt;10&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;</description>
    </item>
    <item>
      <title>Feeds for free</title>
      <link>https://example.com/blog/posts/feeds/</link>
      <guid isPermaLink="true">https://example.com/blog/posts/feeds/</guid>
      <pubDate>Sun, 15 Nov 2026 00:00:00 GMT</pubDate>
      <description>&lt;p&gt;Every post is in the RSS and Atom feeds. See &lt;a href=&quot;https://example.com/blog/posts/hello-sheaf/&quot;&gt;the first post&lt;/a&gt;.&lt;/p&gt;</description>
    </item>
    <item>
      <title>Typed templates</title>
      <link>https://example.com/blog/posts/typed-templates/</link>
      <guid isPermaLink="true">https://example.com/blog/posts/typed-templates/</guid>
      <pubDate>Thu, 05 Nov 2026 00:00:00 GMT</pubDate>
      <description>&lt;p&gt;Templates are Elm functions, so a typo in a field name is a compile error.&lt;/p&gt;</description>
    </item>
    <item>
      <title>Hello, Sheaf</title>
      <link>https://example.com/blog/posts/hello-sheaf/</link>
      <guid isPermaLink="true">https://example.com/blog/posts/hello-sheaf/</guid>
      <pubDate>Sun, 01 Nov 2026 00:00:00 GMT</pubDate>
      <description>&lt;p&gt;This blog is built with Sheaf.&lt;/p&gt;</description>
    </item>
  </channel>
</rss>
"
`;

exports[`the blog fixture writes every route, both feeds and the sitemap under the base path: posts/pictures/index.html 1`] = `
"<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Pictures and code</title><link rel="canonical" href="https://example.com/blog/posts/pictures/"><link rel="stylesheet" href="/blog/style.1989b1b8.css"><meta property="og:title" content="Pictures and code"><meta property="og:description" content="A cover, a photo, a callout and some Elm."><meta property="og:image" content="https://example.com/blog/_sheaf/images/7c46cc0f0b698d66-1200.png"><meta property="og:url" content="https://example.com/blog/posts/pictures/"><meta property="og:type" content="article"><meta property="article:published_time" content="2026-11-19T00:00:00Z"><meta property="article:modified_time" content="2026-11-19T00:00:00Z"><meta name="description" content="A cover, a photo, a callout and some Elm."><link rel="alternate" type="application/rss+xml" title="Test blog" href="/blog/feed.xml"><link rel="alternate" type="application/atom+xml" title="Test blog" href="/blog/atom.xml"></head><body><header><nav><a href="/blog/">Home</a><a href="/blog/archive/">Archive</a><a href="/blog/tags/">Tags</a><a href="/blog/about/">About</a></nav></header><main><article><h1>Pictures and code</h1><time datetime="2026-11-19">2026-11-19</time><picture><source type="image/webp" srcset="/blog/_sheaf/images/7c46cc0f0b698d66-480.webp 480w, /blog/_sheaf/images/7c46cc0f0b698d66-960.webp 960w, /blog/_sheaf/images/7c46cc0f0b698d66-1200.webp 1200w" sizes="(min-width: 1200px) 1200px, 100vw"><img src="/blog/_sheaf/images/7c46cc0f0b698d66-1200.png" srcset="/blog/_sheaf/images/7c46cc0f0b698d66-480.png 480w, /blog/_sheaf/images/7c46cc0f0b698d66-960.png 960w, /blog/_sheaf/images/7c46cc0f0b698d66-1200.png 1200w" sizes="(min-width: 1200px) 1200px, 100vw" width="1200" height="630" alt="Cover" decoding="async" loading="eager"></picture><p>Every image is published in several widths.</p><p><picture><source type="image/webp" srcset="/blog/_sheaf/images/6408dc9e106f009b-480.webp 480w, /blog/_sheaf/images/6408dc9e106f009b-960.webp 960w, /blog/_sheaf/images/6408dc9e106f009b-1200.webp 1200w" sizes="(min-width: 1200px) 1200px, 100vw"><img src="/blog/_sheaf/images/6408dc9e106f009b-1200.png" srcset="/blog/_sheaf/images/6408dc9e106f009b-480.png 480w, /blog/_sheaf/images/6408dc9e106f009b-960.png 960w, /blog/_sheaf/images/6408dc9e106f009b-1200.png 1200w" sizes="(min-width: 1200px) 1200px, 100vw" width="1200" height="800" alt="A photo" loading="lazy" decoding="async"></picture></p><aside class="callout note"><p>Each post is in the feeds too, as <a href="/blog/posts/feeds/">the feeds post</a> explains.</p></aside><pre class="shiki" style="background-color:#ffffff;--shiki-dark-bg:#0d1117;color:#1f2328;--shiki-dark:#e6edf3" tabindex="0"><code class="language-elm"><span class="line"><span style="color:#8250DF;--shiki-dark:#D2A8FF">isSmall</span><span style="color:#1F2328;--shiki-dark:#E6EDF3"> </span><span style="color:#CF222E;--shiki-dark:#FF7B72">:</span><span style="color:#1F2328;--shiki-dark:#E6EDF3"> </span><span style="color:#CF222E;--shiki-dark:#FF7B72">Int</span><span style="color:#1F2328;--shiki-dark:#E6EDF3"> </span><span style="color:#CF222E;--shiki-dark:#FF7B72">-&gt;</span><span style="color:#1F2328;--shiki-dark:#E6EDF3"> </span><span style="color:#CF222E;--shiki-dark:#FF7B72">Bool</span></span>
<span class="line"><span style="color:#8250DF;--shiki-dark:#D2A8FF">isSmall</span><span style="color:#1F2328;--shiki-dark:#E6EDF3"> count </span><span style="color:#CF222E;--shiki-dark:#FF7B72">=</span></span>
<span class="line"><span style="color:#1F2328;--shiki-dark:#E6EDF3">    </span><span style="color:#0550AE;--shiki-dark:#79C0FF">0</span><span style="color:#1F2328;--shiki-dark:#E6EDF3"> </span><span style="color:#CF222E;--shiki-dark:#FF7B72">&lt;</span><span style="color:#1F2328;--shiki-dark:#E6EDF3"> count </span><span style="color:#CF222E;--shiki-dark:#FF7B72">&amp;&amp;</span><span style="color:#1F2328;--shiki-dark:#E6EDF3"> count </span><span style="color:#CF222E;--shiki-dark:#FF7B72">&lt;</span><span style="color:#1F2328;--shiki-dark:#E6EDF3"> </span><span style="color:#0550AE;--shiki-dark:#79C0FF">10</span></span></code></pre><ul><li><a href="/blog/tags/elm/">Elm</a></li></ul></article></main><footer><a href="/blog/feed.xml">RSS</a></footer></body></html>"
`;

exports[`the blog fixture writes every route, both feeds and the sitemap under the base path: old-post/index.html 1`] = `"<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Redirecting…</title><meta http-equiv="refresh" content="0; url=/blog/posts/hello-sheaf/"><link rel="canonical" href="https://example.com/blog/posts/hello-sheaf/"><meta name="robots" content="noindex"></head><body><p>This page has moved to <a href="/blog/posts/hello-sheaf/">/blog/posts/hello-sheaf/</a>.</p></body></html>"`;

