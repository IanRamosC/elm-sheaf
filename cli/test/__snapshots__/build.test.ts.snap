"<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Test blog</title>
    <link>https://example.com/blog/</link>
    <description>A blog for tests.</description>
    <language>en</language>
    <lastBuildDate>Sun, 22 Nov 2026 00:00:00 GMT</lastBuildDate>
    <atom:link href="https://example.com/blog/feed.xml" rel="self" type="application/rss+xml"/>
    <managingEditor>ada@example.com (Ada)</managingEditor>
    <item>
      <title>Tags &amp; groups</title>
      <link>https://example.com/blog/posts/tags-and-groups/</link>
      <guid isPermaLink="true">https://example.com/blog/posts/tags-and-groups/</guid>
      <pubDate>Fri, 20 Nov 2026 00:00:00 GMT</pubDate>
      <description>&lt;p&gt;Tags that differ only in case share a page. Read &lt;a href=&quot;https://example.com/blog/about/&quot;&gt;about this blog&lt;/a&gt;.&lt;/p&gt;</description>
    </item>
    <item>
      <title>Pictures and code</title>
      <link>https://example.com/blog/posts/pictures/</link>
      <guid isPermaLink="true">https://example.com/blog/posts/pictures/</guid>
      <pubDate>Thu, 19 Nov 2026 00:00:00 GMT</pubDate>
      <description>&lt;p&gt;Every image is published in several widths.&lt;/p&gt;&lt;p&gt;&lt;picture&gt;&lt;source type=&quot;image/webp&quot; srcset=&quot;https://example.com/blog/_sheaf/images/6408dc9e106f009b-480.webp 480w, https://example.com/blog/_sheaf/images/6408dc9e106f009b-960.webp 960w, https://example.com/blog/_sheaf/images/6408dc9e106f009b-1200.webp 1200w&quot; sizes=&quot;(min-width: 1200px) 1200px, 100vw&quot;&gt;&lt;img src=&quot;https://example.com/blog/_sheaf/images/6408dc9e106f009b-1200.png&quot; srcset=&quot;https://example.com/blog/_sheaf/images/6408dc9e106f009b-480.png 480w, https://example.com/blog/_sheaf/images/6408dc9e106f009b-960.png 960w, https://example.com/blog/_sheaf/images/6408dc9e106f009b-1200.png 1200w&quot; sizes=&quot;(min-width: 1200px) 1200px, 100vw&quot; width=&quot;1200&quot; height=&quot;800&quot; alt=&quot;A photo&quot; loading=&quot;lazy&quot; decoding=&quot;async&quot;&gt;&lt;/picture&gt;&lt;/p&gt;&lt;aside class=&quot;callout note&quot;&gt;&lt;p&gt;Each post is in the feeds too, as &lt;a href=&quot;https://example.com/blog/posts/feeds/&quot;&gt;the feeds post&lt;/a&gt; explains.&lt;/p&gt;&lt;/aside&gt;&lt;pre class=&quot;shiki&quot; style=&quot;background-color:#ffffff;--shiki-dark-bg:#0d1117;color:#1f2328;--shiki-dark:#e6edf3&quot; tabindex=&quot;0&quot;&gt;&lt;code class=&quot;language-elm&quot;&gt;&lt;span class=&quot;line&quot;&gt;&lt;span style=&quot;color:#8250DF;--shiki-dark:#D2A8FF&quot;&gt;isSmall&lt;/span&gt;&lt;span style=&quot;color:#1F2328;--shiki-dark:#E6EDF3&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color:#CF222E;--shiki-dark:#FF7B72&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;color:#1F2328;--shiki-dark:#E6EDF3&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color:#CF222E;--shiki-dark:#FF7B72&quot;&gt;Int&lt;/span&gt;&lt;span style=&quot;color:#1F2328;--shiki-dark:#E6EDF3&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color:#CF222E;--shiki-dark:#FF7B72&quot;&gt;-&amp;gt;&lt;/span&gt;&lt;span style=&quot;color:#1F2328;--shiki-dark:#E6EDF3&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color:#CF222E;--shiki-dark:#FF7B72&quot;&gt;Bool&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;line&quot;&gt;&lt;span style=&quot;color:#8250DF;--shiki-dark:#D2A8FF&quot;&gt;isSmall&lt;/span&gt;&lt;span style=&quot;color:#1F2328;--shiki-dark:#E6EDF3&quot;&gt; count &lt;/span&gt;&lt;span style=&quot;color:#CF222E;--shiki-dark:#FF7B72&quot;&gt;=&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;line&quot;&gt;&lt;span style=&quot;color:#1F2328;--shiki-dark:#E6EDF3&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color:#0550AE;--shiki-dark:#79C0FF&quot;&gt;0&lt;/span&gt;&lt;span style=&quot;color:#1F2328;--shiki-dark:#E6EDF3&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color:#CF222E;--shiki-dark:#FF7B72&quot;&gt;&amp;lt;&lt;/span&gt;&lt;span style=&quot;color:#1F2328;--shiki-dark:#E6EDF3&quot;&gt; count &lt;/span&gt;&lt;span style=&quot;color:#CF222E;--shiki-dark:#FF7B72&quot;&gt;&amp;amp;&amp;amp;&lt;/span&gt;&lt;span style=&quot;color:#1F2328;--shiki-dark:#E6EDF3&quot;&gt; count &lt;/span&gt;&lt;span style=&quot;color:#CF222E;--shiki-dark:#FF7B72&quot;&gt;&amp;lt;&lt;/span&gt;&lt;span style=&quot;color:#1F2328;--shiki-dark:#E6EDF3&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color:#0550AE;--shiki-dark:#79C0FF&quot;&gt;10&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;</description>
    </item>
    <item>
      <title>Feeds for free</title>
      <link>https://example.com/blog/posts/feeds/</link>
      <guid isPermaLink="true">https://example.com/blog/posts/feeds/</guid>
      <pubDate>Sun, 15 Nov 2026 00:00:00 GMT</pubDate>
      <description>&lt;p&gt;Every post is in the RSS and Atom feeds. See &lt;a href=&quot;https://example.com/blog/posts/hello-sheaf/&quot;&gt;the first post&lt;/a&gt;.&lt;/p&gt;</description>
    </item>
    <item>
      <title>Formatting on save</title>
      <link>https://example.com/blog/posts/formatting/</link>
      <guid isPermaLink="true">https://example.com/blog/posts/formatting/</guid>
