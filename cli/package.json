{
  "name": "elm-sheaf",
  "version": "1.0.0-dev",
  "description": "Static site generator whose templates are written in Elm.",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IanRamosC/elm-sheaf.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/IanRamosC/elm-sheaf#readme",
  "bugs": {
    "url": "https://github.com/IanRamosC/elm-sheaf/issues"
  },
  "keywords": [
    "elm",
    "static-site-generator",
    "blog",
    "bun"
  ],
  "type": "module",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "sheaf": "src/index.ts",
    "elm-sheaf": "src/index.ts"
  },
  "engines": {
    "bun": ">=1.4.5"
  },
  "packageManager": "bun@1.4.5",
  "scripts": {
    "test": "bun test",
    "embed-starter": "bun scripts/embed-starter.ts",
    "embed-fixtures": "bun scripts/embed-protocol-fixtures.ts",
    "screenshots": "bun scripts/screenshots.ts",
    "check": "bunx --bun biome check . && bunx --bun tsc --noEmit",
    "build-binaries": "bun scripts/build-binaries.ts",
    "smoke-binary": "bun scripts/smoke-binary.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.5",
    "@types/mdast": "^4.0.4",
    "tm-grammars": "1.32.22",
    "tm-themes": "1.12.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "mdast-util-definitions": "^6.0.0",
    "mdast-util-directive": "^3.2.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-directive": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-util-sanitize-uri": "^2.0.1",
    "shiki": "^4.6.0",
    "yaml": "^2.9.1"
  }
}
