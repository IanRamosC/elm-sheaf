{
    "type": "package",
    "name": "ianramosc/elm-sheaf",
    "summary": "Typed templates for a static site generator.",
    "license": "BSD-3-Clause",
    "version": "1.0.0",
    "exposed-modules": [
        "Sheaf",
        "Sheaf.Blog",
        "Sheaf.Collection",
        "Sheaf.Date",
        "Sheaf.Document",
        "Sheaf.Feed",
        "Sheaf.Frontmatter",
        "Sheaf.Head",
        "Sheaf.Html",
        "Sheaf.Html.Attributes",
        "Sheaf.Program",
        "Sheaf.Ref",
        "Sheaf.Route"
    ],
    "elm-version": "0.19.3 <= v < 0.20.0",
    "dependencies": {
        "elm/core": "1.0.5 <= v < 2.0.0",
        "elm/json": "1.1.4 <= v < 2.0.0",
        "elm/time": "1.0.0 <= v < 2.0.0"
    },
    "test-dependencies": {
        "elm-explorations/test": "2.2.1 <= v < 3.0.0"
    }
}
