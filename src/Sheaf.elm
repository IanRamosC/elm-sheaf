module Sheaf exposing (Site, site, link)

{-| Sheaf is a static site generator whose templates are written in Elm.

A site is a list of routes. Each route turns a single template, or every
document of a collection, into pages. `Content.Posts` is generated by Sheaf
from `content/posts/`, with one reference per document:

    module Site exposing (site)

    import Content.Posts
    import Sheaf
    import Sheaf.Collection as Collection exposing (Collection)
    import Sheaf.Document exposing (Document)
    import Sheaf.Frontmatter as Frontmatter
    import Sheaf.Html exposing (article, h1, p, text)
    import Sheaf.Route as Route exposing (Page)

    type alias PostMeta =
        { title : String }

    posts : Collection PostMeta
    posts =
        Collection.named "posts"
            (Frontmatter.succeed PostMeta
                |> Frontmatter.required "title" Frontmatter.string
            )

    site : Sheaf.Site
    site =
        Sheaf.site
            { language = "en"
            , routes =
                [ Route.single "/" home
                , Route.eachItem "/posts/:slug/" posts post
                ]
            }

    home : Page
    home =
        { title = "Home"
        , body = [ p [] [ Sheaf.link Content.Posts.helloWorld [ text "Hello, world" ] ] ]
        }

    post : Document PostMeta -> Page
    post document =
        { title = document.meta.title
        , body = [ article [] (h1 [] [ text document.meta.title ] :: document.body) ]
        }

@docs Site, site, link

-}

import Sheaf.Html exposing (Html)
import Sheaf.Internal.Html as Html
import Sheaf.Internal.Site as Internal
import Sheaf.Ref exposing (Ref)
import Sheaf.Route exposing (Route)


{-| A whole site, ready for the host to build.
-}
type alias Site =
    Internal.Site


{-| A site with these routes, whose pages are in `language` (for the `lang`
attribute of `<html>`).
-}
site : { language : String, routes : List Route } -> Site
site =
    Internal.Site


{-| A link to a document, such as `Sheaf.link Content.Posts.helloWorld [ text "Hello" ]`.

Its URL comes from the [`Route.eachItem`](Sheaf-Route#eachItem) route of the
document's collection. A link to a document that has no page in this build,
such as a draft, is reported when the site is built.

-}
link : Ref -> List Html -> Html
link =
    Html.link
