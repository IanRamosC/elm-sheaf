module Sheaf exposing (Site, Metadata, site, withRoutes, withFeeds, withComponents, link, groupLink)

{-| Sheaf is a static site generator whose templates are written in Elm.

A site is a list of routes. Each route turns a single template, or every
document of a collection, into pages. `Content.Posts` is generated by Sheaf
from `content/posts/`, with one reference per document. Components, from
[`Sheaf.Component`](Sheaf-Component), render the directives of Markdown:

    module Site exposing (site)

    import Content.Posts
    import Sheaf
    import Sheaf.Collection as Collection exposing (Collection)
    import Sheaf.Component as Component
    import Sheaf.Document exposing (Document)
    import Sheaf.Frontmatter as Frontmatter
    import Sheaf.Html exposing (article, aside, h1, p, text)
    import Sheaf.Route as Route exposing (Page)

    type alias PostMeta =
        { title : String }

    posts : Collection PostMeta
    posts =
        Collection.named "posts"
            (Frontmatter.succeed PostMeta
                |> Frontmatter.required "title" Frontmatter.string
            )

    site : Sheaf.Site
    site =
        Sheaf.site
            { metadata =
                { title = "My blog"
                , description = "Notes on Elm."
                , author = { name = "Ada Lovelace", email = Nothing }
                , language = "en"
                }
            , routes =
                [ Route.single "/" home
                , Route.eachItem "/posts/:slug/" posts post
                ]
            , feeds = []
            , components =
                [ Component.container "aside" (Component.succeed ()) (\() -> aside [])
                ]
            }

    home : Page
    home =
        { title = "Home"
        , head = []
        , body = [ p [] [ Sheaf.link Content.Posts.helloWorld [ text "Hello, world" ] ] ]
        }

    post : Document PostMeta -> Page
    post document =
        { title = document.meta.title
        , head = []
        , body = [ article [] (h1 [] [ text document.meta.title ] :: document.body) ]
        }

For a blog, [`Sheaf.Blog`](Sheaf-Blog) declares the usual routes and feeds
from a few layouts, using only what this package exposes.

@docs Site, Metadata, site, withRoutes, withFeeds, withComponents, link, groupLink

-}

import Sheaf.Component exposing (Component)
import Sheaf.Feed exposing (Feed)
import Sheaf.Html exposing (Html)
import Sheaf.Internal.Html as Html
import Sheaf.Internal.Site as Internal
import Sheaf.Ref exposing (Ref)
import Sheaf.Route exposing (Route)


{-| A whole site, ready for the host to build.
-}
type alias Site =
    Internal.Site


{-| The title, description and author of the site, and the language of its
pages (for the `lang` attribute of `<html>`).
-}
type alias Metadata =
    Internal.Metadata


{-| A site with these routes, feeds and components.
-}
site : { metadata : Metadata, routes : List Route, feeds : List Feed, components : List Component } -> Site
site =
    Internal.Site


{-| Adds routes after the ones the site has.

    Blog.site config |> Sheaf.withRoutes [ Route.single "/about/" about ]

-}
withRoutes : List Route -> Site -> Site
withRoutes extra (Internal.Site site_) =
    Internal.Site { site_ | routes = site_.routes ++ extra }


{-| Adds feeds after the ones the site has.
-}
withFeeds : List Feed -> Site -> Site
withFeeds extra (Internal.Site site_) =
    Internal.Site { site_ | feeds = site_.feeds ++ extra }


{-| Adds components after the ones the site has.

    Sheaf.site { metadata = metadata, routes = routes, feeds = [], components = [] }
        |> Sheaf.withComponents [ callout, youtube ]

-}
withComponents : List Component -> Site -> Site
withComponents extra (Internal.Site site_) =
    Internal.Site { site_ | components = site_.components ++ extra }


{-| A link to a document, such as `Sheaf.link Content.Posts.helloWorld [ text "Hello" ]`.

Its URL comes from the [`Route.eachItem`](Sheaf-Route#eachItem) route of the
document's collection. A link to a document that has no page in this build,
such as a draft, is reported when the site is built.

-}
link : Ref -> List Html -> Html
link =
    Html.link


{-| A link to the page of a group made by a
[`Route.groupedBy`](Sheaf-Route#groupedBy) route, given the route's pattern
and a value as written in frontmatter:

    Sheaf.groupLink "/tags/:group/" "Elm" [ text "Elm" ]

A spelling that differs only in case, accents or separators finds the same
group, as long as some document's frontmatter writes it that way: if one post
is tagged `Élm` and another `elm`, both spellings link to the same page. Two
values whose slugs merely match, such as `C` and `C++`, are different groups
and are reported as a collision. A pattern no `groupedBy` route has, a value
not written in any frontmatter, and a group with no published documents are
reported when the site is built.

-}
groupLink : String -> String -> List Html -> Html
groupLink =
    Html.groupLink
